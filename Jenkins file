pipeline {
    agent any

    stages {

        stage('Checkout Code') {
            steps {
                git 'https://github.com/tejasai1997/Jenkins-Sonarqube-Docker.git'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    sh '''
                    sonar-scanner \
                    -Dsonar.projectKey=onix-website-scan \
                    -Dsonar.projectBaseDir=.
                    '''
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t onix-website:latest .'
            }
        }

        stage('Deploy Docker Container') {
            steps {
                sh '''
                docker rm -f onix-container || true
                docker run -d -p 8080:80 --name onix-container onix-website:latest
                '''
            }
        }
    }
}

